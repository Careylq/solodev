# ============================================
# ONBOARDPILOT — ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS
# 1. Copy this file to .env.local (which is gitignored):
#      cp .env.example .env.local
# 2. Replace the placeholder values with your real credentials.
# 3. NEVER commit .env.local and NEVER paste real keys into an AI assistant prompt.
#
# ============================================

# --- Required -------------------------------------------------------------
# DeepSeek API key used by the five analyst agents.
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# --- Optional but recommended --------------------------------------------
# A read-only GitHub token raises the GitHub API rate limit from 60 to 5,000
# requests per hour, which makes repeated analyses much more reliable.
# Create one at: https://github.com/settings/tokens  (no scopes are required
# for public repositories).
GITHUB_TOKEN=

# ============================================
# SECURITY REMINDERS
# - .env.example is safe to commit; .env.local is NOT.
# - Never hardcode credentials in source files.
# - Read every value through process.env.
# - Never paste credentials into Bob, Copilot or any AI assistant prompt.
# ============================================
